{
  "name": "dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dashboard",
  "projectType": "application",
  "tags": ["layer:frontend"],
  "// targets": "to see all targets run: nx show project dashboard --web",
  "targets": {
    "build": {
      "dependsOn": []
    },
    "dev": {
      "options": {
        "port": 3000
      }
    },
    "start": {
      "options": {
        "port": 3000
      }
    },
    "start:local": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/dashboard",
        "command": "next start --port=3000"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "defaultConfiguration": "dev",
      "options": {
        "engine": "docker",
        "context": "apps/dashboard",
        "file": "Dockerfile",
        "build-args": ["application_path=dashboard"],
        "tags": ["cas-dashboard:latest"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {}
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dashboard-e2e",
        "command": "playwright test"
      }
    },
    "e2e:ci": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dashboard-e2e",
        "command": "happo -- playwright test"
      }
    },
    "e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dashboard-e2e",
        "command": "playwright test --ui"
      }
    },
    "e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dashboard-e2e",
        "command": "playwright show-report"
      }
    }
  }
}
