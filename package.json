{
  "name": "cas-registration",
  "version": "5.22.0",
  "main": "index.js",
  "repository": "https://github.com/bcgov/cas-registration.git",
  "author": "ggircs@gov.bc.ca",
  "license": "Apache-2.0",
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "release-it": "^20.2.1"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    },
    "hooks": {
      "before:bump": "./.bin/release-bump-chart-version.sh ${version} && ./.bin/release-create-empty-migrations.sh ${version}",
      "before:git:beforeRelease": "./.bin/hook-format.sh CHANGELOG.md"
    }
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "undici@npm:7.28.0": "^7.29.0"
  },
  "dependencies": {
    "@google/genai": "^2.24.0"
  },
  "type": "module",
  "scripts": {
    "context:db": "npx repomix --include 'bc_obps/rls/**,bc_obps/registration/**,bc_obps/compliance/**' --style markdown --output .docs/context-source-database-schema.md",
    "context:backend": "npx repomix --include 'bc_obps/bc_obps/**,bc_obps/service/**,bc_obps/manage.py' --style markdown --output .docs/context-source-backend-services.md",
    "context:frontend": "npx repomix --include 'bciers/apps/**' --style markdown --output .docs/context-source-frontend-components.md",
    "context:tests": "npx repomix --include 'bc_obps/tests/**' --style markdown --output .docs/context-source-test-framework.md",
    "context:guidelines": "npx repomix --include 'bc_obps/Makefile,bc_obps/Dockerfile' --style markdown --output .docs/context-source-team-instructions.md",
    "context:all": "npm run context:db && npm run context:backend && npm run context:frontend && npm run context:tests && npm run context:guidelines"
  }
}
