{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>bcgov/renovate-config#2026.10.29',
  ],
  labels: [
    'dependencies',
    'run-all-ci',
  ],
  prConcurrentLimit: 5,
  dependencyDashboard: {
    enabled: false,
  },
  automerge: false,
  platformAutomerge: false,
  vulnerabilityAlerts: {
    enabled: true,
    schedule: [
      'at any time',
    ],
    labels: [
      'security',
      'dependencies',
      'run-all-ci',
    ],
    rangeStrategy: 'bump',
  },
  constraints: {
    node: '24.x',
    yarn: '4.x',
    python: '3.15.2',
  },
  ignoreDeps: [],
  ignorePaths: [
    'helm/**',
    'data_import/**',
    'data_import_facilities/**',
    'disaster_recovery/**',
    'k6_results/**',
    '.github/workflows/*.lock.yml',
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'every weekend',
    ],
  },
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      description: 'Nx packages — must stay in sync',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        '/^@nx//',
        '/^nx$/',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Nx (non-major)',
      groupSlug: 'nx-non-major',
    },
    {
      description: 'Major updates: individual PRs, never grouped',
      matchUpdateTypes: [
        'major',
      ],
      groupName: null,
      addLabels: [
        'major-update',
      ],
    },
  ],
}
